# Example configuration. install.php writes the real backend/.env for you; never commit that file.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tracker.example.com
APP_TIMEZONE=Africa/Dar_es_Salaam
# 64 random hex characters (generated by the installer): used to hash reset tokens
APP_KEY=replace-with-64-random-hex-characters

DB_HOST=localhost
DB_PORT=3306
DB_NAME=expense_tracker
DB_USER=expense_user
DB_PASS="change-me"

# Optional: store uploads/backups outside the web root (absolute path, writable by PHP)
# STORAGE_PATH=/home/youruser/expense-tracker-storage
MAIL_FROM=no-reply@tracker.example.com
# SMTP (needed for verification and password-reset emails on most hosts; PHP mail() is often blocked).
# Leave MAIL_HOST empty to fall back to PHP mail(). MAIL_FROM should be an address your SMTP account may send as.
MAIL_HOST=
MAIL_PORT=465
# ssl (port 465), tls (STARTTLS, port 587) or none
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
ALLOW_UNINSTALL=false
